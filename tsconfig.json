{
  "include": ["src/**/*.ts"],
  "exclude": ["dist", "site"],
  "compilerOptions": {
    "esModuleInterop": true,
    "rootDir": "src",
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "declaration": true,
    "declarationDir": "./",
    "skipLibCheck": true,
    "isolatedModules": true
  }
}
